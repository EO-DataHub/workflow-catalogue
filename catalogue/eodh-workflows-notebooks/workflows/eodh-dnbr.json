    "properties": {
        "created": "2026-11-26T00:00:00Z",
        "updated": "2026-11-26T00:00:00Z",
        "type": "workflow",
        "title": "dNBR burn severity",
        "description": "Calculates the Differenced Normalised Burn Ratio (dNBR), NBR(baseline) - NBR(item), for one post-fire Sentinel-2 L2A or Sentinel-2 ARD item over an area of interest, on the 10 m nir grid, and classifies it into the seven USGS burn-severity classes (Key & Benson, 2006). The baseline item is the item from the same collection and tile inside the baseline date range with the least cloud, ties going to the date closest to the input item. dNBR is shown with the rdylgn_r colour map from -1 to 1, and the classes with the USGS colours.",
        "keywords": [
            "dnbr",
            "nbr",
            "burn",
            "burn severity",
            "fire",
            "change detection",
            "index",
            "sentinel2",
            "analysis",
            "remote sensing"
        ],
        "language": "en",
        "license": "Apache-2.0",
        "applicableCollections": [
            "sentinel-2-c1-l2a",
            "sentinel2_ard"
        ],
        "contacts": [
            {
                "name": "EODH Platform Team",
                "organization": "EO DataHub",
                "roles": [
                    "author"
                ],
                "links": [
                    {
                        "href": "https://eodatahub.org.uk",
                        "rel": "about",
                        "type": "text/html",
                        "title": "EO DataHub Platform"
                    }
                ]
            }
        ],
        "inputParameters": {
            "stac_item": {
                "label": "STAC item",
                "type": "raster",
                "hubType": "stac-item",
                "description": "The post-fire Sentinel-2 L2A or Sentinel-2 ARD item to calculate dNBR for",
                "required": true,
                "cwlType": "string"
            },
            "aoi": {
                "label": "Area of interest",
                "type": "vector",
                "hubType": "aoi",
                "description": "The area to calculate dNBR over, as a GeoJSON Polygon or MultiPolygon. Pixels outside it are left empty.",
                "required": true,
                "cwlType": "string"
            },
            "baseline": {
                "label": "Baseline date range",
                "type": "date",
                "hubType": "date-range",
                "description": "The pre-fire dates, as start/end. The workflow uses the item from the same collection and tile in this range with the least cloud, ties going to the date closest to the input item. The range must end before the item's date.",
                "required": true,
                "cwlType": "string"
            }
        },
